{
  "name": "herald",
  "private": true,
  "description": "One inbox for AI agents, scripts and webhooks — live, actionable notifications on every device.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @herald/server --filter @herald/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "deploy": "pnpm --filter @herald/web build && pnpm --filter @herald/server run deploy",
    "android:build": "cd apps/android && ./gradlew assembleDebug",
    "macos:build": "apps/apple/scripts/build-macos-app.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
