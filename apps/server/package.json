{
  "name": "@oyee/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-assets.mjs && wrangler d1 migrations apply oyee --local && wrangler dev",
    "deploy": "wrangler d1 migrations apply oyee --remote && node scripts/deploy.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/ensure-assets.mjs && vitest run",
    "build": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply oyee --local",
    "db:migrate:remote": "wrangler d1 migrations apply oyee --remote",
    "vapid": "node scripts/generate-vapid-keys.mjs",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@oyee/schema": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.9",
    "@cloudflare/workers-types": "^5.20261027.1",
    "drizzle-kit": "^0.31.11",
    "wrangler": "^4.153.0"
  }
}
